# Cat Frame — Expo client configuration
#
# Copy this file to `.env` in the repo root and fill in the blanks. `.env` is
# gitignored; this template is committed, so never put a real value in here.
#
# `EXPO_PUBLIC_*` variables are inlined into the JavaScript bundle at build
# time. Treat everything here as published: it ships inside the app, and anyone
# can read it out of the binary. Nothing secret belongs in this file.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Same Project URL the server uses.
EXPO_PUBLIC_SUPABASE_URL=

# The `anon` (publishable) key — NOT `service_role`.
#
# This one is designed to be public. It carries no privileges of its own; what
# a request can actually do is decided by row level security and by the signed
# in user's token. That is exactly why every table has RLS enabled and denies
# by default: this key is the thing an attacker starts with.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
