# Cat Frame — server configuration
#
# Copy this file to `server/.env` and fill in the blanks. `.env` is gitignored;
# this template is committed, so never put a real value in here.
#
# Every variable below is validated at boot by src/config.ts. A missing or empty
# required value stops the process with a named error rather than failing later
# inside a request.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# The app's client defaults to http://localhost:4000, so the server listens
# there unless you change both. See src/api/client.ts.
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
# Also the base for the JWKS endpoint and the token issuer, both derived in
# src/config.ts — there is nothing else to fill in for auth.
SUPABASE_URL=

# The `service_role` key. It bypasses row level security entirely.
#
# Server only. It must never reach the app bundle, a client-side env var, or a
# commit. If it leaks, rotate it in the dashboard immediately — anyone holding
# it can read and write every row in the database.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------

# The model judges the photograph and returns the four score components, the pose, the
# badges and the cat's traits — one call per capture, on an already-downscaled image.
#
# Both are optional. Without them the server still starts and still stores captures; every
# score simply fails, and says so.
OPENAI_API_KEY=
OPENAI_SCORING_MODEL=

# How much of the photograph the model is billed for looking at: auto | low | high.
#
# `low` is a flat image cost regardless of file size — a far bigger saving than resizing, and
# the lever to reach for if spend becomes the binding constraint. It costs fidelity and
# composition is a third of the score, so it is not the default. Bump SCORING_VERSION if you
# change it: it changes what the model can see.
OPENAI_IMAGE_DETAIL=auto

# Invent scores locally instead of calling anybody, for building the loop before the
# scorer is wired up. Refused outright when NODE_ENV=production, and every score it makes
# up is stamped `stub` in scoring_model so those rows are identifiable forever.
SCORING_STUB=true

# Makes the stub answer "there is no cat in this photograph".
#
# Only meaningful with SCORING_STUB on. The `no_cat` path — the failure reason, the `no_cat_at`
# stamp, the guard that reads it back before paying for a second look — has never executed,
# because the stub always said yes. This is how to exercise it.
SCORING_STUB_NO_CAT=false

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# How many reverse proxies sit in front of this process. A COUNT, never `true`.
#
# Rate limiting by address is only as honest as the address. Behind a proxy the socket
# belongs to the proxy, so Express reads X-Forwarded-For instead — but that header is
# written by whoever is talking to you unless something in the path overwrites it.
# `trust proxy = true` takes the leftmost value, which the caller supplied, so an attacker
# sends a fresh one per request and every per-address limit becomes decoration.
#
# 0 trusts nothing and uses the socket address: correct for local development, and for any
# host where this process is reachable directly. Set it to the number of proxies you
# actually have — one for most platform hosts — and no higher. Guessing high is the
# failure that looks like it works.
TRUST_PROXY=0

# Turns every rate limiter off. Development only — refused when NODE_ENV=production.
#
# For device testing, where one phone plus a reloading Expo client can look like a flood
# and the limit you hit is your own.
RATE_LIMIT_DISABLED=false

# ---------------------------------------------------------------------------
# Not needed, and deliberately absent
# ---------------------------------------------------------------------------
#
# SUPABASE_JWT_SECRET — this project signs tokens with an ECC (P-256) key, so
# there is no shared secret to hold. The server verifies signatures against
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json and caches the keys. Rotating
# to a standby key needs no change here and no redeploy.
#
# DATABASE_URL / DIRECT_URL — the server talks to Supabase over HTTPS through
# supabase-js, not Postgres over TCP. Those connection strings are for running
# migrations and for psql, so they live in your shell, not in the server's env.
