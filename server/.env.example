# Cat Frame — server configuration
#
# Copy this file to `server/.env` and fill in the blanks. `.env` is gitignored;
# this template is committed, so never put a real value in here.
#
# Every variable below is validated at boot by src/config.ts. A missing or empty
# required value stops the process with a named error rather than failing later
# inside a request.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# The app's client defaults to http://localhost:4000, so the server listens
# there unless you change both. See src/api/client.ts.
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
# Also the base for the JWKS endpoint and the token issuer, both derived in
# src/config.ts — there is nothing else to fill in for auth.
SUPABASE_URL=

# The `service_role` key. It bypasses row level security entirely.
#
# Server only. It must never reach the app bundle, a client-side env var, or a
# commit. If it leaks, rotate it in the dashboard immediately — anyone holding
# it can read and write every row in the database.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------

# The model judges the photograph and returns the four score components, the pose, the
# badges and the cat's traits — one call per capture, on an already-downscaled image.
#
# Both are optional. Without them the server still starts and still stores captures; every
# score simply fails, and says so.
OPENAI_API_KEY=
OPENAI_SCORING_MODEL=

# Invent scores locally instead of calling anybody, for building the loop before the
# scorer is wired up. Refused outright when NODE_ENV=production, and every score it makes
# up is stamped `stub` in scoring_model so those rows are identifiable forever.
SCORING_STUB=true

# ---------------------------------------------------------------------------
# Not needed, and deliberately absent
# ---------------------------------------------------------------------------
#
# SUPABASE_JWT_SECRET — this project signs tokens with an ECC (P-256) key, so
# there is no shared secret to hold. The server verifies signatures against
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json and caches the keys. Rotating
# to a standby key needs no change here and no redeploy.
#
# DATABASE_URL / DIRECT_URL — the server talks to Supabase over HTTPS through
# supabase-js, not Postgres over TCP. Those connection strings are for running
# migrations and for psql, so they live in your shell, not in the server's env.
