# Supabase Postgres. Used purely as a managed Postgres connection string — Node is the
# only thing with a database connection, and the Supabase auto-API / RLS are not used.
# Use the pooled (pgbouncer) URL for the app and the direct URL for migrations.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

PORT=4000
NODE_ENV=development

# Sign access and refresh tokens with DIFFERENT secrets so a leaked access secret cannot
# be used to mint refresh tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me-access"
JWT_REFRESH_SECRET="replace-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Redis. Optional in Phase 1 — matchmaking and live battle state need it in Phase 2.
# Leave unset locally and the server falls back to an in-process stub (single instance only).
REDIS_URL=""

# Server-side catch verification. Chosen: Google Cloud Vision (see README section 12).
VISION_PROVIDER="google"
GOOGLE_VISION_API_KEY=""
# Set true to skip the Vision call in local dev. NEVER true in production — this is the
# anti-cheat checkpoint for the entire catch loop.
VISION_DEV_BYPASS=true

# Social sign-in
GOOGLE_OAUTH_CLIENT_IDS="ios-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com"
APPLE_BUNDLE_ID="app.pawgo.client"

# Photo storage. Node issues short-lived signed upload URLs; the client never gets a key.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="cat-photos"
PHOTO_CDN_BASE_URL=""

# In-app purchase receipt validation
APPLE_SHARED_SECRET=""
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""

# Push
EXPO_ACCESS_TOKEN=""

SENTRY_DSN=""
