    "jose": "^6.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.4",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2"
  }
}
